Customer -[#2980B9]-> UC10
Customer -[#2980B9]-> UC12
Customer -[#2980B9]-> UC13
Customer -[#2980B9]-> UC14

' Administrator associations - ORANGE
Admin -[#E67E22]-> UC2
Admin -[#E67E22]-> UC17
Admin -[#E67E22]-> UC18
Admin -[#E67E22]-> UC19

' AWS associations - GREEN
AWS -[#27AE60]-> UC7
AWS -[#27AE60]-> UC8
AWS -[#27AE60]-> UC9

' Notification associations - PURPLE
Notify -[#8E44AD]-> UC7

