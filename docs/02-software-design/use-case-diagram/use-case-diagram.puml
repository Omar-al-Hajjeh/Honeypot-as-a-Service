UC4 -[#2471A3,dashed]-> UC5 : <<include>>
UC7 -[#2471A3,dashed]-> UC11 : <<include>>

' Extend relationships - PURPLE
UC15 -[#8E44AD,dashed]-> UC13 : <<extend>>
UC16 -[#8E44AD,dashed]-> UC13 : <<extend>>

@enduml
